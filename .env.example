# Copy to .env (git-ignored) or export in your shell. Never commit real keys.
DEEPSEEK_API_KEY=
# Optional overrides
# ISSUEPILOT_BASE_URL=https://api.deepseek.com
# ISSUEPILOT_DB_PATH=.issuepilot/runs.db
# Override USD per 1M tokens (defaults: DeepSeek Flash list price, peak-aware).
# ISSUEPILOT_PRICE_INPUT_PER_M=0.15
# ISSUEPILOT_PRICE_OUTPUT_PER_M=0.60
# Optional: read-only token for fetching issues (--github-issue); needs no write scope.
# GITHUB_TOKEN=
# API: directory that repo_path values must live under.
# ISSUEPILOT_REPOS_ROOT=/path/to/your/repos
